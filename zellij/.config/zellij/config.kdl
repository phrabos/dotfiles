// Zellij config: vim-style mode keys, compact bar, Catppuccin Mocha.
//
// Alt is also the window-manager modifier (Hyprland on Linux, AeroSpace on
// macOS), and those grab Alt+a/d/f/h/j/k/l/m/r/s/t/v/[/]/0-9/Tab before Zellij
// sees them. Only bind Alt keys here that are free on both machines.

keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    resize {
        bind "Ctrl n" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "p" { SwitchFocus; SwitchToMode "Normal"; }
        bind ";" { FocusLastPane; SwitchToMode "Normal"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "Shift f" { ToggleFocusNoUiFullscreen; SwitchToMode "Normal"; }
        bind "f" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "i" { TogglePanePinned; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        // Move mode lives here because Alt m belongs to the window manager.
        bind "m" { SwitchToMode "Move"; }
        // Swap layouts; stays in pane mode so repeated presses keep cycling.
        bind "[" { PreviousSwapLayout; }
        bind "]" { NextSwapLayout; }
    }
    move {
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }
    tab {
        bind "Ctrl t" { SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "l" "Right" "Down" "j" { GoToNextTab; SwitchToMode "Normal"; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "a" { ToggleTab; SwitchToMode "Normal"; }
        bind "H" { MoveTab "Left"; }
        bind "L" { MoveTab "Right"; }
    }
    // [ ] m c need shell integration (OSC 133), see ~/.config/zsh/osc133.zsh.
    scroll {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "G" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
    }
    search {
        bind "Ctrl /" { SwitchToMode "Normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl f" "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }
    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }
    session {
        bind "Ctrl x" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        // Quit lives here, not on a global key, so it can't be hit by accident.
        bind "q" { Quit; }
        bind "]" { FocusHostSession; SwitchToMode "Normal"; }
        bind "[" { FocusGuestSession; SwitchToMode "Normal"; }
        bind "f" { ToggleHostFullscreen; SwitchToMode "Normal"; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "a" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
    tmux {
        bind "[" { SwitchToMode "Scroll"; }
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; }
        bind "d" { Detach; }
        bind "Space" { NextSwapLayout; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Alt n" { NewPane; }
        bind "Alt Space" { ToggleFloatingPanes; }
        bind "Alt e" { TogglePaneEmbedOrFloating; }
        bind "Alt p" { TogglePaneInGroup; }
        bind "Alt \\" { FocusLastPane; }
        // Ghostty-style pane navigation (macOS standard)
        bind "Super Alt Left" { MoveFocusOrTab "Left"; }
        bind "Super Alt Right" { MoveFocusOrTab "Right"; }
        bind "Super Alt Down" { MoveFocus "Down"; }
        bind "Super Alt Up" { MoveFocus "Up"; }
        // Ghostty-style vim navigation
        bind "Ctrl Shift h" { MoveFocusOrTab "Left"; }
        bind "Ctrl Shift l" { MoveFocusOrTab "Right"; }
        bind "Ctrl Shift j" { MoveFocus "Down"; }
        bind "Ctrl Shift k" { MoveFocus "Up"; }
        bind "Alt y" { MoveTab "Left"; }
        bind "Alt u" { MoveTab "Right"; }
        bind "Alt ," { GoToPreviousTab; }
        bind "Alt ." { GoToNextTab; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        // Blocked by Hyprland on Linux; Ctrl p then [ / ] works everywhere.
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt g" {
            LaunchOrFocusPlugin "room" {
                floating true
                move_to_focused_tab true
                ignore_case true
            };
            SwitchToMode "Normal"
        }
        bind "Alt b" {
            LaunchOrFocusPlugin "harpoon" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        // Fuzzy-find a file under the focused pane's cwd and copy its path.
        bind "Alt /" {
            Run "zellij-find-file" {
                floating true
                close_on_exit true
                name "find file"
            };
            SwitchToMode "Normal"
        }
    }
    shared_except "normal" "locked" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
    shared_except "pane" "locked" {
        bind "Ctrl p" { SwitchToMode "Pane"; }
    }
    shared_except "tab" "locked" {
        bind "Ctrl t" { SwitchToMode "Tab"; }
        bind "Alt ;" { ToggleTab; SwitchToMode "Normal"; }
    }
    shared_except "resize" "locked" {
        bind "Ctrl n" { SwitchToMode "Resize"; }
    }
    shared_except "scroll" "locked" {
        bind "Ctrl f" { SwitchToMode "Scroll"; }
    }
    shared_except "session" "locked" {
        bind "Ctrl x" { SwitchToMode "Session"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
}

// Plugin aliases. Changes require a restart.
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    // F1 toggles the keybinding hints; they also appear when entering a mode.
    compact-bar location="zellij:compact-bar" {
        tooltip "F1"
    }
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
    // Third-party plugins, pinned release binaries stored in ./plugins:
    // room v1.2.1 (github.com/rvcas/room), harpoon v0.3.0 (github.com/Nacho114/harpoon)
    room location="file:~/.config/zellij/plugins/room.wasm"
    harpoon location="file:~/.config/zellij/plugins/harpoon.wasm"
}

// Background plugins loaded on session start. link highlights file paths and
// opens them in $EDITOR on Alt+Click.
load_plugins {
    "zellij:link"
}

// Built-in Catppuccin Mocha (new theme spec, styles the compact bar too).
theme "catppuccin-mocha"

// One title line above each pane instead of a full border.
pane_frame_style "titles"

show_startup_tips false
show_release_notes true

// No default_cwd here on purpose. It only accepts a literal absolute path
// (zellij expands neither ~ nor $HOME), and /home vs /Users means no single
// value works on both machines. Pass it at launch instead - the shell expands
// $HOME there:
//   zellij options --default-cwd "$HOME/Projects"
// Without it, panes start in whatever directory launched the session.

// Lines of scrollback kept per pane (default 10000). Halved: every pane holds
// its own buffer, so a many-pane session costs hundreds of MB at the default.
scroll_buffer_size 5000

// Also save each pane's visible screen with the session, so a resurrected
// session (after a logout or reboot) shows what was on screen instead of empty
// panes. Tabs, splits, cwds and commands are restored regardless.
//
// scrollback_lines_to_serialize is left unset on purpose: unset saves only the
// visible screen, 0 would save the whole scrollback. Saved text lands in plain
// files under ~/.cache/zellij, so keep it small (lab output, tokens, flags).
//
// Requires a zellij restart to take effect.
serialize_pane_viewport true

// No copy_command: copying uses OSC 52, which Ghostty supports on both machines.

// Opens pane scrollback (Ctrl f, e) in a stripped-down nvim.
scrollback_editor "zellij-scrollback"
