#!/bin/sh
# swaync-toggle - backs the quick-settings buttons in the swaync control
# center (buttons-grid in ~/.config/swaync/config.json).
#
#   swaync-toggle wifi|bluetooth|mic          apply $SWAYNC_TOGGLE_STATE
#   swaync-toggle wifi|bluetooth|mic status   print true/false for the button
#   swaync-toggle screenshot|lock|power       close the panel, then act
#                                             (power opens power-menu)
#
# Why a script rather than inline commands: swaync runs every command as
# /bin/sh -c "<command>" after GLib shell-parsing it, so inline double quotes
# need double escaping inside JSON, and /bin/sh is dash here, so the [[ ]]
# idiom from swaync's own example config fails silently.
#
# swaync sets SWAYNC_TOGGLE_STATE to the button's NEW state ("true" = the
# button was just switched on). The update command runs each time the panel
# opens, so a change made elsewhere (nm-applet, blueman, the mute key) shows
# up the next time the panel opens.

# swaync may have been D-Bus-activated with a PATH that lacks ~/.local/bin.
PATH="$HOME/.local/bin:$PATH"

on() { [ "$SWAYNC_TOGGLE_STATE" = true ]; }
bool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }

close_panel() {
    swaync-client -sw -cp >/dev/null 2>&1
    # Let the panel finish its slide-out (transition-time is 200ms) so it is
    # not caught in a screenshot or left open over the lock screen.
    sleep 0.3
}

case "$1:$2" in
    wifi:status)
        bool test "$(nmcli radio wifi)" = enabled ;;
    wifi:)
        if on; then nmcli radio wifi on; else nmcli radio wifi off; fi ;;

    bluetooth:status)
        # "No default controller available" (adapter soft-blocked) = off.
        bool sh -c 'bluetoothctl show | grep -q "Powered: yes"' ;;
    bluetooth:)
        if on; then
            # Powering on fails while rfkill has the adapter soft-blocked.
            rfkill unblock bluetooth
            bluetoothctl power on
        else
            bluetoothctl power off
        fi ;;

    # "on" means the microphone is live, so the button lights up when you
    # can be heard.
    mic:status)
        bool sh -c '! wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED' ;;
    mic:)
        if on; then wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
        else wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1; fi ;;

    screenshot:)
        close_panel; exec screenshot-wl region ;;
    lock:)
        close_panel; exec loginctl lock-session ;;
    power:)
        close_panel; exec power-menu ;;

    *)
        echo "usage: ${0##*/} wifi|bluetooth|mic [status] | screenshot|lock|power" >&2
        exit 2 ;;
esac
