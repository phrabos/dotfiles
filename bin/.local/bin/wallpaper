#!/bin/sh
# Wallpaper picker, bound to SUPER+SHIFT+W.
#
#   wallpaper              pick from ~/Pictures/wallpapers in Vicinae's list
#   wallpaper <name|path>  set that one directly (no picker)
#   wallpaper --random     pick one at random
#
# Applies over hyprpaper IPC (instant, no restart) AND rewrites the path lines
# in hyprpaper.conf so the choice survives a logout.
#
# Two hyprpaper 0.8 quirks this works around:
#   - the monitor field cannot be blank: `hyprctl hyprpaper wallpaper ",path"`
#     returns success and does nothing, so each output is set by name.
#   - there is no preload/reload any more; `wallpaper` is the only verb.

set -eu

DIR="$HOME/Pictures/wallpapers"
CONF="$HOME/.config/hypr/hyprpaper.conf"
FIT=cover

die() { notify-send -u critical "Wallpaper" "$1" 2>/dev/null || echo "$1" >&2; exit 1; }

[ -d "$DIR" ] || die "No wallpaper directory at $DIR"

# find, not ls: ls is aliased to eza in this shell, whose column headers would
# end up in the list.
list() {
    find "$DIR" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        -printf '%f\n' | sort
}

case "${1:-}" in
    --random) choice=$(list | shuf -n 1) ;;
    "")       choice=$(list | vicinae dmenu \
                  --navigation-title "Wallpaper" \
                  --placeholder "Pick a wallpaper..." \
                  --section-title "{count} wallpapers") ;;
    *)        choice=$(basename "$1") ;;
esac

# Empty means the picker was dismissed.
[ -n "$choice" ] || exit 0

path="$DIR/$choice"
[ -f "$path" ] || die "No such wallpaper: $choice"

# Portrait screens (the HP, rotated) get a portrait crop: `cover` on a tall,
# narrow output enlarges a thin centre strip of a landscape image, usually its
# brightest part. The crop is made once and kept in $DIR/portrait/ under the
# same name - outside the picker's list, which only reads $DIR itself. It is
# the darkest of seven evenly spaced 9:16 strips, so what shows through
# translucent windows stays calm. Already-tall images are used as they are.
portrait_for() {
    src="$1"
    out="$DIR/portrait/$(basename "$src")"
    [ -f "$out" ] && { echo "$out"; return; }
    command -v magick >/dev/null 2>&1 || { echo "$src"; return; }
    set -- $(magick identify -format '%w %h' "$src[0]")
    w=$1 h=$2
    cw=$((h * 9 / 16))
    [ "$cw" -lt "$w" ] || { echo "$src"; return; }
    best_x=0 best_mean=2
    for i in 0 1 2 3 4 5 6; do
        x=$(((w - cw) * i / 6))
        mean=$(magick "$src[0]" -crop "${cw}x${h}+${x}+0" -colorspace Gray -format '%[fx:mean]' info:)
        if awk "BEGIN { exit !($mean < $best_mean) }"; then best_x=$x best_mean=$mean; fi
    done
    mkdir -p "$DIR/portrait"
    magick "$src[0]" -crop "${cw}x${h}+${best_x}+0" +repage -filter Lanczos \
        -resize '1080x1920!' -quality 92 "$out"
    echo "$out"
}

# Every connected output, by name (an unnamed monitor field is ignored).
# transform 1/3/5/7 = rotated 90 or 270 degrees, i.e. portrait.
hyprctl monitors -j | jq -r '.[] | "\(.name) \(.transform)"' | while read -r monitor transform; do
    case "$transform" in
        1 | 3 | 5 | 7) img=$(portrait_for "$path") ;;
        *)             img="$path" ;;
    esac
    hyprctl hyprpaper wallpaper "$monitor,$img,$FIT" >/dev/null
done

# Persist. --follow-symlinks matters: this config is stowed, and without it sed
# would replace the symlink with a regular file and break the dotfiles link.
# Lines pointing into portrait/ (the HP's block) get the portrait crop; the
# rest get the landscape image.
if [ -f "$CONF" ]; then
    sed -i --follow-symlinks -E "\|/portrait/|! s|^( *path *= *).*|\1$path|" "$CONF"
    if grep -q '/portrait/' "$CONF"; then
        portrait=$(portrait_for "$path")
        # Only if a crop was made: writing a landscape path here would drop
        # the /portrait/ marker this relies on.
        case "$portrait" in */portrait/*) ;; *) exit 0 ;; esac
        sed -i --follow-symlinks -E "\|/portrait/| s|^( *path *= *).*|\1$portrait|" "$CONF"
    fi
fi

# Stable pointer to the current wallpaper for things that want "the
# wallpaper" rather than a file name - hyprlock's background uses it.
mkdir -p "$HOME/.local/state/wallpaper"
ln -sfn "$path" "$HOME/.local/state/wallpaper/current"

notify-send -t 2000 -i "$path" "Wallpaper" "$choice" 2>/dev/null || true
